; VACUUM HEROES – Godot 4.3+ Mobile
config_version=5

[application]
config/name="Vacuum Heroes"
config/description="VACUUM HEROES / שואב הגיבורים"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]
Economy="*res://scripts/economy.gd"
GameManager="*res://scripts/game_manager.gd"
; Locale="*res://scripts/locale.gd"
; AudioManager="*res://scripts/audio_manager.gd"
; IAPManager="*res://scripts/iap_manager.gd"
; AdsManager="*res://scripts/ads_manager.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
